# ===== חובה =====
# כתובת המייל שאליה אנשים שולחים קישורים (מומלץ ג'ימייל חדש שמיועד רק לזה)
EMAIL_ADDRESS=slyhttmwnwtwsrtwnym@gmail.com
# בג'ימייל: "סיסמת אפליקציה" (App Password) בת 16 אותיות, לא הסיסמה הרגילה
EMAIL_PASSWORD=abcdabcdabcdabcd

# ===== שרתי מייל (ברירת מחדל: Gmail) =====
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ===== שליחה דרך Google Apps Script (לשרתים שחוסמים SMTP, כמו Railway) =====
# ראו README ו-deploy/gmail-send-relay.gs
# SEND_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# SEND_SCRIPT_SECRET=

# ===== סינון צניעות =====
# כל תמונה וסרטון נבדקים לפני השליחה. מה שלא צנוע, או שאי אפשר לבדוק, לא נשלח.
# שכבה בסיסית (חינם) פועלת תמיד. עם מפתח של Anthropic נוספת בדיקה מחמירה לפי כללי צניעות.
# ANTHROPIC_API_KEY=sk-ant-...
# MODERATION_MODEL=claude-opus-5-5
# MODERATION=on

# ===== אופציונלי =====
# מאילו אתרים מקבלים קישורים: * = כל אתר ציבורי (ברירת מחדל), או רשימת אתרים (כולל תתי-דומיינים)
# ALLOWED_DOMAINS=*
# אתרי שיחות AI: מקישור שיתוף נשלחים כל התמונות והסרטונים שבשיחה
# CHAT_SHARE_HOSTS=chatgpt.com,chat.openai.com,gemini.google.com,gemini.google,g.co,bard.google.com,claude.ai,copilot.microsoft.com,grok.com,perplexity.ai,chat.deepseek.com,meta.ai,poe.com,chat.mistral.ai
# MAX_FILES_PER_LINK=10
# לבדיקת תקלות: מצרף לתשובה צילום מסך של דף שנכשל
# DEBUG_SCREENSHOTS=false
# קובץ גדול מזה נשלח כקישור להורדה במקום כקובץ מצורף
# MAX_FILE_MB=18
# MAX_TOTAL_MB=18
# MAX_LINKS_PER_EMAIL=10
# MAX_EMAILS_PER_SENDER_PER_HOUR=30
# FETCH_TIMEOUT_SECONDS=20
# דפדפן נסתר לדפים שבנויים ב-JavaScript (מגניפיק, לאונרדו)
# USE_BROWSER_FALLBACK=true
# CHROMIUM_PATH=
# POLL_INTERVAL_SECONDS=60

# Website quota and phone check (see README)
# FREE_PER_DAY=8
# PACK_SIZE=10
# PACK_PRICE=2
# PUBLIC_URL=https://your-site.example
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SID=

# Pixabay blocks automated browsers; its free API gives the file (https://pixabay.com/api/docs/)
# PIXABAY_API_KEY=

# Send through the Vercel relay (deploy/vercel-mail-relay): ~500 emails a day instead of ~100
# MAIL_RELAY_URL=https://your-project.vercel.app/api/send
# MAIL_RELAY_SECRET=
